#!/bin/bash -e
#SBATCH --job-name=pfc-build
#SBATCH --partition=Debug
#SBATCH --nodes=1
#SBATCH --ntasks=32
#SBATCH --ntasks-per-node=32
#SBATCH --cpus-per-task=1
#SBATCH --gpus-per-node=4
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --output=%j.out
#SBATCH --error=%j.err

source /etc/bashrc
module purge
module load pfc/2026.1
PFC_DIR="$PFC_ROOT"
export PFC_GPU_ARCH=gfx906

cd "$PFC_DIR"
make bin/polygrpfc
