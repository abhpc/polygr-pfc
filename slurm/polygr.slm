#!/bin/bash -e
#SBATCH --job-name=polygrpfc
#SBATCH --partition=Debug
#SBATCH --nodes=1
#SBATCH --ntasks=32
#SBATCH --ntasks-per-node=32
#SBATCH --cpus-per-task=1
#SBATCH --gpus-per-node=4
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --output=%j.out
#SBATCH --error=%j.err

# 1. Load the solver environment and retain the project path for postprocessing.
source /etc/bashrc
module purge
module load pfc/2026.1
PFC_DIR="$PFC_ROOT"
PFC_RUN_ROOT="$PFC_DIR/runs"
export PFC_DIR
export DISPLAY=

# 2. Create a new directory for this job.
PFC_JOB_DIR="$PFC_RUN_ROOT/$SLURM_JOB_ID"
mkdir -p "$PFC_RUN_ROOT"
mkdir "$PFC_JOB_DIR"
mkdir "$PFC_JOB_DIR/dcu"

# 3. Prepare the original two-stage input. W/H are in angstrom.
W=1000
H=1000
N=100
R=2
PFC_WIDTH=$(awk -v value="$W" 'BEGIN {print int(1024/243*value)}')
PFC_HEIGHT=$(awk -v value="$H" 'BEGIN {print int(1024/243*value)}')
cp "$PFC_DIR/example/step1.in" "$PFC_DIR/example/step2.in" "$PFC_JOB_DIR/dcu/"
cd "$PFC_JOB_DIR/dcu"
RX=$(od -An -N4 -tu4 /dev/urandom | tr -d '[:space:]')
sed -i "s@xabc@$RX@g;s@WW@$PFC_WIDTH@g;s@HH@$PFC_HEIGHT@g;s@NN@$N@g;s@RR@$R@g" step1.in
sed -i "s@WW@$PFC_WIDTH@g;s@HH@$PFC_HEIGHT@g" step2.in

# 4. Grow grains, then relax the first-stage result.
mpirun -bootstrap fork -np 32 -ppn 32 polygrpfc step1 > step1.stdout 2> step1.stderr
mpirun -bootstrap fork -np 32 -ppn 32 polygrpfc step2 > step2.stdout 2> step2.stderr

# 5. Convert the final field using the existing Java/OVITO pipeline.
bash -e "$PFC_DIR/slurm/convert.sh" step2-10000.dat "$PFC_WIDTH" "$PFC_HEIGHT"

# 6. Export grayscale frames.
module purge
module load anaconda3/2023.07
python "$PFC_DIR/source/plotter.py" 'step1-#.dat' 'step1-#.png' "$PFC_WIDTH" "$PFC_HEIGHT" 0 1000 10000 > "$PFC_JOB_DIR/step1-images.stdout" 2> "$PFC_JOB_DIR/step1-images.stderr"
python "$PFC_DIR/source/plotter.py" 'step2-#.dat' 'step2-#.png' "$PFC_WIDTH" "$PFC_HEIGHT" 0 1000 10000 > "$PFC_JOB_DIR/step2-images.stdout" 2> "$PFC_JOB_DIR/step2-images.stderr"
